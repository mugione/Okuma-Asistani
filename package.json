{
  "name": "okuhiz",
  "version": "1.0.0",
  "description": "OkuHız – Akıllı Okuma Antrenörü",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "seed:generate": "node scripts/generate-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply okuhiz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply okuhiz-db --remote",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.141.0"
  },
  "private": true
}
