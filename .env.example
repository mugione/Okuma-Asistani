# Cloudflare kimlik bilgileri – GERÇEK DEĞERLERİ BU DOSYAYA YAZMAYIN.
# Terminalde export edin veya .env (git'e girmez) içinde tutun.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ElevenLabs – yalnızca kelime seslerini yeniden üretmek için (npm run audio:generate).
# Uygulama çalışırken kullanılmaz. Anahtarda yalnızca Text to Speech izni yeterlidir.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
